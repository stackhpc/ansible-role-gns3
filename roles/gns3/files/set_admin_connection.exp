#!/usr/bin/expect -f

# Wait indefinitely for the initial boot/login prompt.
set timeout -1

if {$argc != 3} {
    puts "Requires 3 arguments: <telnet-port> <interface> <ip-address>"
    exit 1
}

set port [lindex $argv 0]
set mgmt_iface [lindex $argv 1]
set mgmt_ipaddr [lindex $argv 2]

spawn telnet localhost $port

# Uncomment for debugging
exp_internal 1

#
# Send enter once to prompt
#

sleep 3

send "\r"
send "\r"
send "\r"

expect -re {OS10 login:}
send "admin\r"

expect -re {Password:}
send "admin\r"

#
# Try logging in as admin first
#
expect {
    -re {OS10#} {
        puts "Logged in as admin."
    }

    -re {Login incorrect} {
        puts "Admin login failed. Resetting password via linuxadmin."

        expect -re {OS10 login:}
        send "linuxadmin\r"

        expect -re {Password:}
        send "linuxadmin\r"

        expect -re {linuxadmin@OS10:~\$ *}

        send "sudo passwd admin\r"

expect {
    -re {\[sudo\] password for linuxadmin:} {
        send "linuxadmin\r"

        expect {
            -re {New password:} {
                send "admin\r"

                expect -re {Retype new password:}
                send "admin\r"

                expect -re {linuxadmin@OS10:~\$ *}
            }

            -re {passwd: user 'admin' does not exist} {
                puts "admin user does not exist yet. Waiting 3 minutes before retrying..."
                sleep 180

                send "sudo passwd admin\r"

                expect -re {\[sudo\] password for linuxadmin:}
                send "linuxadmin\r"

                expect -re {New password:}
                send "admin\r"

                expect -re {Retype new password:}
                send "admin\r"

                expect -re {linuxadmin@OS10:~\$ *}
            }

            timeout {
                puts "Timed out waiting for passwd."
                exit 1
            }
        }
    }

    -re {passwd: user 'admin' does not exist} {
        puts "admin user does not exist yet. Waiting 3 minutes before retrying..."
        sleep 180

        send "sudo passwd admin\r"

        expect -re {\[sudo\] password for linuxadmin:}
        send "linuxadmin\r"

        expect -re {New password:}
        send "admin\r"

        expect -re {Retype new password:}
        send "admin\r"

        expect -re {linuxadmin@OS10:~\$ *}
    }

    timeout {
        puts "Timed out starting passwd."
        exit 1
    }
}

        expect -re {linuxadmin@OS10:~\$ *}

        send "exit\r"

        send "\r"
        send "\r"
        send "\r"

        expect -re {OS10 login:}
        send "admin\r"

        expect -re {Password:}
        send "admin\r"

        expect {
            -re {OS10#} {}

            timeout {
                puts "Failed to login as admin after password reset."
                close
                wait
                exit 1
            }
        }
    }

    timeout {
        puts "Timed out waiting for login result."
        close
        wait
        exit 1
    }
}

#
# Wait until we reach the CLI
#

send "\r"
send "\r"
send "\r"

expect {
    -re {OS10#} {}

    timeout {
        puts "Failed to login as admin."
        close
        wait
        exit 1
    }
}

#
# Configure switch
#
send "configure terminal\r"

expect {
    -re {OS10\(config\)#} {}
    -re {Cancelling ZTD Process.*OS10\(config\)#} {}
}

send "interface $mgmt_iface\r"
expect -re {OS10\(conf-if.*\)#}

send "no ip address dhcp\r"
expect -re {OS10\(conf-if.*\)#}

send "ip address $mgmt_ipaddr\r"
expect -re {OS10\(conf-if.*\)#}

send "no shutdown\r"
expect -re {OS10\(conf-if.*\)#}

send "exit\r"
expect -re {OS10\(config\)#}

send "write memory\r"

#
# Return to privileged EXEC mode
#
send "end\r"
expect -re {OS10#}

#
# Save configuration
#
send "write memory\r"
expect -re {OS10#}

#
# Logout of the switch
#
send "exit\r"

# Wait until we're back at the login prompt
expect -re {OS10 login:}

#
# Close the telnet session cleanly
#
close
wait

exit 0